/// 员工账号状态
enum UserStatus {
  ACTIVE
  INACTIVE
}

/// 权限节点类型
enum PermissionType {
  MENU
  BUTTON
  DATA
}

/// 产品状态（公海 or 已入选私有池）
enum ProductStatus {
  PENDING
  SELECTED
  PURCHASING
  ORDERED
}

/// 采购单状态
enum OrderStatus {
  PENDING       // 待下单（内部建单完成，尚未调 1688）
  PLACED        // 已下单/待付款（1688 订单已创建）
  IN_TRANSIT    // 运输中
  PARTIAL       // 部分入库（实到数量 < 计划数量，等待剩余货物或人工强制结单）
  RECEIVED      // 已全部入库
  CANCELLED     // 已取消（1688 交易取消后冻结，历史凭据保留，需求已释放回采购计划）
}

/// 库存流水类型
enum InventoryLogType {
  PURCHASE_IN     // 采购入库（本地仓入库，stockActual +）
  FBE_OUT         // FBE 出库（发货至 eMAG 仓，stockActual -）
  MANUAL_ADJUST   // 人工盘点调整（可正可负）
}

