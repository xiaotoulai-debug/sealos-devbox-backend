/// 员工个人任务中心：仅用于“我创建/指派给我”的任务协作，不承载全员任务看板
model EmployeeTask {
  id             Int                  @id @default(autoincrement())
  title          String
  description    String?              @db.Text
  taskType       EmployeeTaskType     @map("task_type")
  platform       OperationPlatform?
  shopId         Int?                 @map("shop_id")
  priority       EmployeeTaskPriority @default(MEDIUM)
  status         EmployeeTaskStatus   @default(TODO)
  creatorId      Int                  @map("creator_id")
  assigneeId     Int                  @map("assignee_id")
  dueDate        DateTime             @map("due_date")
  completedAt    DateTime?            @map("completed_at")
  cancelledAt    DateTime?            @map("cancelled_at")
  relatedSkuText String?              @map("related_sku_text") @db.Text
  remark         String?              @db.Text
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  creator  User               @relation("EmployeeTaskCreator", fields: [creatorId], references: [id])
  assignee User               @relation("EmployeeTaskAssignee", fields: [assigneeId], references: [id])
  shop     ShopAuthorization? @relation(fields: [shopId], references: [id], onDelete: SetNull)
  logs     EmployeeTaskLog[]
  comments EmployeeTaskComment[]

  @@index([assigneeId, status, dueDate])
  @@index([creatorId, status, dueDate])
  @@index([assigneeId, status, completedAt])
  @@index([assigneeId, status, cancelledAt])
  @@index([creatorId, status, createdAt])
  @@index([creatorId, status, completedAt])
  @@index([dueDate])
  @@index([status])
  @@index([taskType])
  @@index([platform])
  @@index([createdAt])
  @@index([assigneeId, dueDate])
  @@index([status, dueDate])
  @@index([updatedAt])
  @@map("employee_tasks")
}

/// 员工任务操作日志：记录创建、状态变更、内容修改和取消，便于后续审计
model EmployeeTaskLog {
  id         Int                   @id @default(autoincrement())
  taskId     Int                   @map("task_id")
  operatorId Int                   @map("operator_id")
  action     EmployeeTaskLogAction
  fromStatus EmployeeTaskStatus?   @map("from_status")
  toStatus   EmployeeTaskStatus?   @map("to_status")
  remark     String?               @db.Text
  createdAt  DateTime              @default(now()) @map("created_at")

  task     EmployeeTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  operator User         @relation(fields: [operatorId], references: [id])

  @@index([taskId])
  @@index([operatorId])
  @@index([createdAt])
  @@map("employee_task_logs")
}

/// 员工任务沟通评论：支持 @ 提及任意用户
model EmployeeTaskComment {
  id               Int      @id @default(autoincrement())
  taskId           Int      @map("task_id")
  authorId         Int      @map("author_id")
  content          String   @db.Text
  mentionedUserIds Json?    @map("mentioned_user_ids")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  task   EmployeeTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User         @relation(fields: [authorId], references: [id])

  @@index([taskId])
  @@index([authorId])
  @@map("employee_task_comments")
}

/// 员工任务上周汇总 AI 缓存：按 userId + weekStart 唯一，sourceHash 不变则复用
model EmployeeWeeklyAiSummary {
  id            Int                           @id @default(autoincrement())
  userId        Int                           @map("user_id")
  weekStart     DateTime                      @map("week_start") @db.Date
  weekEnd       DateTime                      @map("week_end") @db.Date
  sourceHash    String                        @map("source_hash")
  provider      String                        @default("deepseek")
  model         String
  promptVersion String                        @map("prompt_version")
  status        EmployeeWeeklyAiSummaryStatus @default(PENDING)
  summaryJson   Json?                         @map("summary_json")
  rawText       String?                       @map("raw_text") @db.Text
  errorMessage  String?                       @map("error_message") @db.Text
  inputTokens   Int?                          @map("input_tokens")
  outputTokens  Int?                          @map("output_tokens")
  costEstimate  Decimal?                      @map("cost_estimate") @db.Decimal(10, 6)
  generatedAt   DateTime?                     @map("generated_at")
  createdAt     DateTime                      @default(now()) @map("created_at")
  updatedAt     DateTime                      @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, weekStart])
  @@index([userId, weekStart, status])
  @@index([status, weekStart])
  @@map("employee_weekly_ai_summaries")
}

/// 全年工作日日历：管理员维护工作日/休息日/待定，用于日报缺失统计
model WorkdayCalendar {
  id          Int           @id @default(autoincrement())
  date        DateTime      @unique @db.Date
  status      WorkdayStatus @default(PENDING)
  remark      String?       @db.Text
  updatedById Int?          @map("updated_by_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  updatedBy User? @relation("WorkdayCalendarUpdatedBy", fields: [updatedById], references: [id])

  @@index([date])
  @@map("workday_calendars")
}

/// 运营每日提醒模板：员工每日 SOP 检查项，不与 EmployeeTask 混用
model DailyReminderTemplate {
  id            Int               @id @default(autoincrement())
  title         String
  category      ReminderCategory
  priority      ReminderPriority
  frequency     ReminderFrequency
  weekdays      Int[]
  suggestedTime String?           @map("suggested_time")
  requireCheck  Boolean           @default(true) @map("require_check")
  platform      OperationPlatform?
  shopId        Int?              @map("shop_id")
  description   String?           @db.Text
  isActive      Boolean           @default(true) @map("is_active")
  createdById   Int               @map("created_by_id")
  updatedById   Int?              @map("updated_by_id")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  shop        ShopAuthorization? @relation(fields: [shopId], references: [id], onDelete: SetNull)
  createdBy   User               @relation("DailyReminderTemplateCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?              @relation("DailyReminderTemplateUpdatedBy", fields: [updatedById], references: [id])
  assignments DailyReminderTemplateAssignment[]
  checks      DailyReminderCheck[]

  @@index([isActive])
  @@index([category])
  @@index([priority])
  @@index([frequency])
  @@index([shopId])
  @@index([createdAt])
  @@map("daily_reminder_templates")
}

/// 运营每日提醒适用对象：支持按员工或角色分配
model DailyReminderTemplateAssignment {
  id         Int                          @id @default(autoincrement())
  templateId Int                          @map("template_id")
  targetType ReminderAssignmentTargetType @map("target_type")
  userId     Int?                         @map("user_id")
  roleId     Int?                         @map("role_id")
  createdAt  DateTime                     @default(now()) @map("created_at")

  template DailyReminderTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user     User?                 @relation(fields: [userId], references: [id])
  role     Role?                 @relation(fields: [roleId], references: [id])

  @@index([templateId])
  @@index([targetType, userId])
  @@index([targetType, roleId])
  @@map("daily_reminder_template_assignments")
}

/// 员工每日提醒检查记录：按 template + user + date 唯一 upsert
model DailyReminderCheck {
  id         Int                 @id @default(autoincrement())
  templateId Int                 @map("template_id")
  userId     Int                 @map("user_id")
  checkDate  DateTime            @map("check_date") @db.Date
  status     ReminderCheckStatus
  note       String?             @db.Text
  checkedAt  DateTime?           @map("checked_at")
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  template DailyReminderTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user     User                  @relation(fields: [userId], references: [id])

  @@unique([templateId, userId, checkDate])
  @@index([userId, checkDate])
  @@index([templateId, checkDate])
  @@index([status])
  @@map("daily_reminder_checks")
}

