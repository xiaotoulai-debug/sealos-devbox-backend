generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// 员工表
model User {
  id           Int        @id @default(autoincrement())
  username     String     @unique
  passwordHash String     @map("password_hash")
  name         String
  avatar       String?
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  roleId       Int        @map("role_id")
  products       Product[]
  fbeShipments   FbeShipment[]
  operationDailyLogs OperationDailyLog[]
  operationDailyReports OperationDailyReport[]
  createdEmployeeTasks EmployeeTask[] @relation("EmployeeTaskCreator")
  assignedEmployeeTasks EmployeeTask[] @relation("EmployeeTaskAssignee")
  employeeTaskLogs EmployeeTaskLog[]
  employeeTaskComments EmployeeTaskComment[]
  createdDailyReminderTemplates DailyReminderTemplate[] @relation("DailyReminderTemplateCreatedBy")
  updatedDailyReminderTemplates DailyReminderTemplate[] @relation("DailyReminderTemplateUpdatedBy")
  dailyReminderAssignments DailyReminderTemplateAssignment[]
  dailyReminderChecks DailyReminderCheck[]
  updatedWorkdayCalendars WorkdayCalendar[] @relation("WorkdayCalendarUpdatedBy")
  employeeWeeklyAiSummaries EmployeeWeeklyAiSummary[]
  role           Role       @relation(fields: [roleId], references: [id])

  @@map("users")
}

/// 角色表
model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  permissions RolePermission[]
  users       User[]
  dailyReminderAssignments DailyReminderTemplateAssignment[]

  @@map("roles")
}

/// 权限节点表（树状结构核心）
model Permission {
  id        Int              @id @default(autoincrement())
  code      String           @unique
  name      String
  type      PermissionType
  sortOrder Int              @default(0) @map("sort_order")
  parentId  Int?             @map("parent_id")
  parent    Permission?      @relation("PermissionTree", fields: [parentId], references: [id])
  children  Permission[]     @relation("PermissionTree")
  roles     RolePermission[]

  @@map("permissions")
}

/// 角色-权限 中间表（多对多关联，方便后续扩展字段如 grantedAt）
model RolePermission {
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  assignedAt   DateTime   @default(now()) @map("assigned_at")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// 产品表（eMAG 选品池）
model Product {
  id                Int            @id @default(autoincrement())
  pnk               String         @unique
  title             String
  brand             String?
  price             Decimal?       @db.Decimal(10, 2)
  tags              String[]
  rating            Decimal?       @db.Decimal(3, 2)
  reviewCount       Int?           @map("review_count")
  category          String?
  categoryL1        String?        @map("category_l1")
  categoryL2        String?        @map("category_l2")
  categoryL3        String?        @map("category_l3")
  categoryL4        String?        @map("category_l4")
  imageUrl          String?        @map("image_url")
  productUrl        String?        @map("product_url")
  costPrice         Decimal?       @map("cost_price") @db.Decimal(10, 2)
  stock             Int            @default(0)
  linkTag           String?        @map("link_tag")
  purchasePrice     Decimal?       @map("purchase_price") @db.Decimal(10, 2)
  purchaseUrl       String?        @map("purchase_url")
  actualWeight      Decimal?       @map("actual_weight") @db.Decimal(10, 3)
  freightCost       Decimal?       @map("freight_cost") @db.Decimal(10, 2)
  fbeFee            Decimal?       @map("fbe_fee") @db.Decimal(10, 2)
  margin            Decimal?       @map("margin") @db.Decimal(6, 2)
  collectedAt       DateTime?      @map("collected_at")
  length            Decimal?       @map("length") @db.Decimal(10, 2)
  width             Decimal?       @map("width") @db.Decimal(10, 2)
  height            Decimal?       @map("height") @db.Decimal(10, 2)
  sku               String?        @unique @map("sku")
  chineseName       String?        @map("chinese_name")
  developer         String?        @map("developer")
  purchaseQuantity  Int?           @map("purchase_quantity")
  purchaseType      String?        @map("purchase_type")
  purchasePeriod    Int?           @map("purchase_period")
  handlingTime      Int            @default(2) @map("handling_time")
  returnLossRate    Float?         @default(0) @map("return_loss_rate") // 退货损耗率（小数，0.03 = 3%），null 时视同 0
  vat               Int            @default(19)
  publishStatus     String         @default("UNPUBLISHED") @map("publish_status")
  externalProductId String?        @map("external_product_id")
  externalSkuId     String?        @map("external_sku_id")     // 1688 specId：32位 MD5 哈希（万邦 spec_id），优先用于下单
  externalSkuIdNum  String?        @map("external_sku_id_num") // 1688 skuId：纯数字，用于 cargoParamList.skuId 兜底
  externalSynced    Boolean        @default(false) @map("external_synced")
  externalOrderId   String?        @map("external_order_id")
  stockActual       Float          @default(0) @map("stock_actual")
  stockInTransit    Float          @default(0) @map("stock_in_transit")
  inTransitQuantity Int            @default(0) @map("in_transit_quantity") // ERP内部FBE在途数量（由发货单状态流转维护）
  sales1d           Int            @default(0) @map("sales_1d")
  sales7d           Int            @default(0) @map("sales_7d")
  sales14d          Int            @default(0) @map("sales_14d")
  sales30d          Int            @default(0) @map("sales_30d")
  status            ProductStatus  @default(PENDING)
  isDeleted         Boolean        @default(false) @map("is_deleted") // 软删除标记（有关联数据时降级使用）
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  ownerId           Int?           @map("owner_id")
  purchaseOrderId   Int?           @map("purchase_order_id")
  shopId            Int?           @map("shop_id") // 采购计划归属店铺（从平台产品发起采购时透传，老数据可为空）
  sourceStoreProductId Int?        @map("source_store_product_id") // 采购计划关联的平台产品（StoreProduct.id）
  fbeShipmentId     Int?           @map("fbe_shipment_id")         // 已创建的 FBE 发货单（防重复）
  fbeCreatedAt      DateTime?      @map("fbe_created_at")
  fbeStatus         String?        @map("fbe_status")              // FBE 发货单状态快照（如 PENDING）
  owner             User?          @relation(fields: [ownerId], references: [id])
  purchaseOrder     PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  shop              ShopAuthorization? @relation(fields: [shopId], references: [id], onDelete: SetNull)
  sourceStoreProduct StoreProduct? @relation("ProductSourceStoreProduct", fields: [sourceStoreProductId], references: [id], onDelete: SetNull)
  fbeShipment       FbeShipment?   @relation("ProductFbeShipment", fields: [fbeShipmentId], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@index([category])
  @@index([categoryL1, categoryL2, categoryL3, categoryL4])
  @@index([title])
  @@index([status, ownerId, collectedAt(sort: Desc)])
  @@index([purchaseOrderId])
  @@index([shopId])
  @@index([sku])
  @@index([externalProductId])
  @@index([sourceStoreProductId])
  @@index([fbeShipmentId])
  @@map("products")

  fbeShipmentItems  FbeShipmentItem[]
  inventoryLogs     InventoryLog[]
  warehouseStocks   WarehouseStock[]
}

/// 采购单（主单）
model PurchaseOrder {
  id               Int                   @id @default(autoincrement())
  orderNo          String                @unique @map("order_no")
  operator         String
  totalAmount      Decimal               @map("total_amount") @db.Decimal(12, 2)
  itemCount        Int                   @default(0) @map("item_count")
  status           OrderStatus           @default(PENDING)
  warehouseId      Int?                  @map("warehouse_id")       // 目标入库仓
  shopId           Int?                  @map("shop_id")            // 采购单归属店铺（仓库收货物理区分用，老数据可为空）
  shopNameSnapshot String?               @map("shop_name_snapshot") // 建单时店铺名快照，避免店铺改名影响历史单据展示
  remark           String?
  // ── 1688 采购账号（多账号支持）────────────────────────────────
  alibabaAuthId    Int?                  @map("alibaba_auth_id")
  // ── 1688 订单信息（从子单提取上移，主单维度冗余存储便于列表展示）──
  alibabaOrderId   String?               @map("alibaba_order_id")   // 1688 主订单号
  supplierName     String?               @map("supplier_name")      // 供应商名称
  // ── 物流追踪（支持线下采购手动回填）────────────────────────────
  logisticsCompany String?               @map("logistics_company")  // 物流公司（极兔/顺丰等）
  trackingNumber   String?               @map("tracking_number")    // 运单号
  logisticsStatus  String?               @map("logistics_status")   // 最新物流状态文本
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @default(now()) @updatedAt @map("updated_at")
  warehouse        Warehouse?            @relation(fields: [warehouseId], references: [id])
  shop             ShopAuthorization?    @relation(fields: [shopId], references: [id], onDelete: SetNull)
  alibabaAuth      AlibabaAuth?          @relation(fields: [alibabaAuthId], references: [id], onDelete: SetNull)
  products         Product[]
  items            PurchaseOrderItem[]

  @@index([createdAt(sort: Desc)])
  @@index([operator])
  @@index([status])
  @@index([warehouseId])
  @@index([shopId])
  @@index([alibabaAuthId])
  @@index([alibabaOrderId])
  @@map("purchase_orders")
}

/// 采购子单（一个主单对应多个 1688 卖家子订单）
model PurchaseOrderItem {
  id                  Int           @id @default(autoincrement())
  purchaseOrderId     Int           @map("purchase_order_id")
  offerId             String?       @map("offer_id")           // 1688 商品 offerId（即卖家维度标识）
  productIds          String?       @map("product_ids")        // 关联的本地产品 ID 列表（JSON 数组）
  quantity            Int           @default(1)                // 本批次计划采购数量
  receivedQuantity    Int           @default(0) @map("received_quantity") // 已累计入库数量（支持分批到货）
  createdAt           DateTime      @default(now()) @map("created_at")
  // ── 1688 子单回填字段（一个 offerId 对应一个 1688 子订单）────
  alibabaOrderId      String?       @map("alibaba_order_id")      // 1688 官方订单号
  alibabaOrderStatus  String?       @map("alibaba_order_status")  // 1688 状态: waitbuyerpay / waitsellersend / success
  alibabaTotalAmount  Decimal?      @map("alibaba_total_amount") @db.Decimal(12, 2) // 1688 实际支付金额（含运费）
  shippingFee         Decimal?      @map("shipping_fee") @db.Decimal(10, 2)         // 1688 运费
  // ── 物流追踪字段 ────────────────────────────────────────────
  logisticsCompany    String?       @map("logistics_company")
  logisticsNo         String?       @map("logistics_no")
  purchaseOrder       PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@index([alibabaOrderId])
  @@map("purchase_order_items")
}

/// eMAG 多站点区域枚举（RO=罗马尼亚, BG=保加利亚, HU=匈牙利）
enum EmagRegion {
  RO
  BG
  HU
}

/// 店铺授权（eMAG / Shein / Temu / Amazon 等多平台）
model ShopAuthorization {
  id              Int              @id @default(autoincrement())
  platform        String
  shopName        String           @map("shop_name")
  region          EmagRegion?      // eMAG 站点区域 RO/BG/HU，仅 emag 平台使用；null 时按 shopName 推断
  businessModel   String           @default("TRADITIONAL") @map("business_model")
  apiKey          String           @map("api_key")
  apiSecret       String           @map("api_secret")
  accessToken     String?          @map("access_token")
  refreshToken     String?          @map("refresh_token")
  supplierId      String?          @map("supplier_id")
  expiresAt       DateTime?        @map("expires_at")
  status          String           @default("active")
  isSandbox       Boolean          @default(false) @map("is_sandbox")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  createdBy       Int?             @map("created_by")
  storeProducts   StoreProduct[]
  platformOrders  PlatformOrder[]
  fbeShipments    FbeShipment[]
  purchaseOrders  PurchaseOrder[]
  purchasePlanProducts Product[]
  operationDailyLogs OperationDailyLog[]
  employeeTasks EmployeeTask[]
  dailyReminderTemplates DailyReminderTemplate[]

  @@index([platform])
  @@index([status])
  @@index([businessModel])
  @@map("shop_authorizations")
}

/// 平台订单（eMAG order/read 全量同步到本地）
model PlatformOrder {
  id           Int      @id @default(autoincrement())
  shopId       Int      @map("shop_id")
  emagOrderId  BigInt   @map("emag_order_id")
  status       Int
  statusText   String   @map("status_text")
  orderTime    DateTime @map("order_time")
  orderType    Int?     @map("order_type")
  paymentMode  String?  @map("payment_mode")
  total        Decimal  @db.Decimal(12, 2)
  currency     String?  @default("RON")
  customerJson String?  @map("customer_json") @db.Text
  productsJson String?  @map("products_json") @db.Text
  rawJson      String?  @map("raw_json") @db.Text
  syncedAt     DateTime @default(now()) @map("synced_at")
  shop         ShopAuthorization @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, emagOrderId])
  @@index([shopId])
  @@index([shopId, orderTime(sort: Desc)])
  @@map("platform_orders")
}

/// 店铺在售产品（eMAG product_offer/read 同步，与公海 Product 表分离）
model StoreProduct {
  id               Int      @id @default(autoincrement())
  shopId           Int      @map("shop_id")
  pnk              String   // eMAG part_number_key (如 D9MSJJ3BM)
  vendorSku        String?  @map("vendor_sku") // part_number / 供应商 SKU (如 CDX001)
  sku              String?  // eMAG part_number (平台 SKU)
  ean              String?  // eMAG ean 数组取第一个或合并
  emagOfferId      String?  @map("emag_offer_id")
  name             String
  salePrice        Decimal  @map("sale_price") @db.Decimal(10, 2)
  currency         String?  @default("RON") // eMAG 币种，RO=RON, BG=EUR(2026欧元区), HU=HUF
  stock            Int      @default(0)
  status           Int      @default(1) // 1=Active, 0=Inactive
  categoryId       Int?     @map("category_id")
  imageUrl         String?  @map("image_url")
  mainImage        String?  @map("main_image") // images[display_type=1] 主图 URL
  productUrl       String?  @map("product_url") // 前台商品链接，用于爬虫补图
  mappedInventorySku String? @map("mapped_inventory_sku") // 手动绑定的库存 SKU（对应 Product.sku，纯字符串存储，无 FK 约束）
  validationStatus String?  @map("validation_status")
  docErrors        String?  @map("doc_errors") // eMAG 驳回原因 (JSON 或文本)
  rejectionReason  String?  @map("rejection_reason") // 驳回原因（便于展示）
  comprehensiveSales Float    @default(0) @map("comprehensive_sales") // 综合日销 = d7/7*0.3 + d14/14*0.3 + d30/30*0.4
  // ── 利润预计算缓存字段（由 profitCalculator 定时写入，列表接口直读零计算）──
  commissionRate       Float?     @map("commission_rate")          // eMAG 佣金比例（小数，0.15 = 15%）
  estimatedProfit      Decimal?   @map("estimated_profit") @db.Decimal(12, 2)      // 预估毛利（站点当地货币）
  estimatedProfitCny   Decimal?   @map("estimated_profit_cny") @db.Decimal(12, 2)  // 预估毛利（CNY）
  profitMarginPct      Float?     @map("profit_margin_pct")        // 毛利率 % = profit / salePrice × 100
  profitCalculatedAt   DateTime?  @map("profit_calculated_at")     // 上次利润计算时间
  profitBreakdown      Json?      @map("profit_breakdown")          // 利润明细拆解 JSON（各项扣费 + 估算标识）
  productClass         String?    @map("product_class")             // 平台产品业务分类：HOT/POTENTIAL/NORMAL/DEAD/NEW/TO_BE_ELIMINATED
  classificationReason String?    @map("classification_reason")     // 分类原因说明，面向运营展示
  classificationMetrics Json?     @map("classification_metrics")    // 分类计算指标快照（不伪造 90 天有货数据）
  classifiedAt         DateTime?  @map("classified_at")             // 上次分类计算时间
  // ── eMAG 店铺维度链接身份（shopId + PNK + ownership），不保存完整 raw response ──
  emagLinkType           String?   @map("emag_link_type")            // SELF_BUILT / RESELL / UNKNOWN
  emagLinkTypeSource     String?   @map("emag_link_type_source")     // PUBLISH_LOG / OWNERSHIP / MANUAL / UNKNOWN
  emagLinkTypeConfidence String?   @map("emag_link_type_confidence") // HIGH / MEDIUM / LOW
  emagOwnership          Json?     @map("emag_ownership")            // eMAG 原始 ownership，可能为 boolean/number/string/null
  contentPermission      String?   @map("content_permission")        // EDITABLE / OFFER_ONLY / UNKNOWN
  numberOfOffers         Int?      @map("number_of_offers")
  offerCompetitionType   String?   @map("offer_competition_type")    // EXCLUSIVE / COMPETITIVE / UNKNOWN
  buyButtonRank          Int?      @map("buy_button_rank")
  bestOfferSalePrice     Decimal?  @map("best_offer_sale_price") @db.Decimal(10, 2)
  mainOfferPrice         Decimal?  @map("main_offer_price") @db.Decimal(10, 2)
  linkActionTips         Json?     @map("link_action_tips")          // 前端动作提醒数组
  emagOfferMeta          Json?     @map("emag_offer_meta")           // compact meta: ownership/numberOfOffers/prices/rank/PNK
  buyBoxStatus           String?   @map("buy_box_status")            // WON / LOST / UNKNOWN / NO_ACTIVE_BUYBOX / POSSIBLY_WON / POSSIBLY_LOST
  buyBoxStatusSource     String?   @map("buy_box_status_source")     // BUY_BUTTON_RANK / PRICE_HEURISTIC / OFFER_STATE / UNKNOWN
  buyBoxStatusConfidence String?   @map("buy_box_status_confidence") // HIGH / MEDIUM / LOW
  buyBoxRank             Int?      @map("buy_box_rank")
  buyBoxActionTips       Json?     @map("buy_box_action_tips")       // 购物车状态动作提醒数组
  buyBoxMeta             Json?     @map("buy_box_meta")              // compact meta，不保存完整 raw response
  isArchived      Boolean  @default(false) @map("is_archived") // eMAG 变更 PNK/SKU 后保留审计用的归档标记；列表默认过滤
  firstAvailableAt DateTime? @map("first_available_at") // 当前店铺下首次平台库存 > 0 的时间（新品观察期基准）
  firstStockSignalAt DateTime? @map("first_stock_signal_at") // 首次平台库存>0 或 FBE/ERP 在途>0 的时间
  firstInboundAt     DateTime? @map("first_inbound_at") // 首次 FBE/ERP 在途 > 0 的时间
  syncedAt         DateTime @default(now()) @map("synced_at")
  shop         ShopAuthorization @relation(fields: [shopId], references: [id], onDelete: Cascade)
  inventorySnapshots StoreProductInventorySnapshot[]
  purchasePlanProducts Product[] @relation("ProductSourceStoreProduct")

  @@unique([shopId, pnk])
  @@unique([shopId, sku])
  @@unique([shopId, vendorSku])
  @@unique([shopId, emagOfferId])
  @@index([shopId])
  @@index([pnk])
  @@index([shopId, ean])
  @@index([ean])          // EAN 条码搜索索引，支持扫码枪查询与双格式兼容搜索
  @@index([vendorSku])
  @@index([isArchived])
  @@index([shopId, comprehensiveSales(sort: Desc)])
  @@index([shopId, productClass])
  @@index([shopId, productClass, comprehensiveSales(sort: Desc)])
  @@index([shopId, firstAvailableAt])
  @@index([shopId, firstStockSignalAt])
  @@index([shopId, firstInboundAt])
  @@map("store_products")
}

/// 平台产品每日库存快照：用于第二阶段计算近 90 天有货天数与有货日销
model StoreProductInventorySnapshot {
  id                 Int      @id @default(autoincrement())
  shopId             Int      @map("shop_id")
  storeProductId     Int      @map("store_product_id")
  sku                String?
  snapshotDate       DateTime @map("snapshot_date") @db.Date
  platformStock      Int      @default(0) @map("platform_stock")
  inTransitStock     Int      @default(0) @map("in_transit_stock")
  sales7             Int      @default(0) @map("sales_7")
  sales14            Int      @default(0) @map("sales_14")
  sales30            Int      @default(0) @map("sales_30")
  comprehensiveSales Float    @default(0) @map("comprehensive_sales")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  storeProduct StoreProduct @relation(fields: [storeProductId], references: [id], onDelete: Cascade)

  @@unique([storeProductId, snapshotDate])
  @@index([shopId, snapshotDate])
  @@index([shopId, sku, snapshotDate])
  @@index([storeProductId])
  @@map("store_product_inventory_snapshots")
}

/// 汇率缓存表（每日定时拉取，source→target 货币对，upsert 模式保持唯一）
model ExchangeRate {
  id        Int      @id @default(autoincrement())
  source    String   // 源货币代码: CNY, EUR, RON, HUF
  target    String   // 目标货币代码
  rate      Decimal  @db.Decimal(18, 8) // 1 source = ? target
  fetchedAt DateTime @default(now()) @map("fetched_at")

  @@unique([source, target])
  @@index([source, target])
  @@map("exchange_rates")
}

/// 本地库存/SKU 映射表（历史遗留，当前业务"库存 SKU"已迁移至 Product 表管理）
model Inventory {
  id            Int      @id @default(autoincrement())
  sku           String   @unique // 唯一标识，对应 eMAG part_number
  localImage    String?  @map("local_image") // 本地高清图 URL
  purchaseCost  Decimal? @map("purchase_cost") @db.Decimal(10, 2) // 采购单价
  weight        Decimal? @db.Decimal(10, 3) // 重量 (kg)，用于物流
  length        Decimal? @db.Decimal(10, 2) // 长 (cm)
  width         Decimal? @db.Decimal(10, 2) // 宽 (cm)
  height        Decimal? @db.Decimal(10, 2) // 高 (cm)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([sku])
  @@map("inventory")
}

/// 自动同步日志（订单哨兵、产品雷达、库存同步）
model SyncLog {
  id          Int      @id @default(autoincrement())
  syncType    String   @map("sync_type")   // order_sentinel | product_radar | inventory_sync
  updatedCount Int     @default(0) @map("updated_count")
  durationMs  Int      @default(0) @map("duration_ms")
  result      String?  @db.Text            // success | partial | failed
  detail      String?  @db.Text            // JSON 或简要说明
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([syncType])
  @@index([createdAt(sort: Desc)])
  @@map("sync_logs")
}

/// 运营每日事务登记：员工每天登记运营动作，供首页运营作战看板聚合
model OperationDailyLog {
  id            Int                @id @default(autoincrement())
  reportId      Int?               @map("report_id")
  userId        Int                @map("user_id")
  workDate      DateTime           @map("work_date") @db.Date
  taskType      OperationTaskType  @map("task_type")
  platform      OperationPlatform?
  shopId        Int?               @map("shop_id")
  quantity      Int                @default(0)
  status        OperationLogStatus @default(DONE)
  detail        String?            @db.Text
